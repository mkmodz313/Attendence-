rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admin docs are created ONLY via the Firebase console (secure setup). Never writable from the app.
    match /admins/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if false;
    }

    match /employees/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Workers read only their own records. Self check-in rules (server timestamp + duplicate
    // prevention via deterministic doc id {employeeUid}_{yyyy-MM-dd}) are added in Phase 2.
    match /attendance/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.employeeUid == request.auth.uid);
      allow write: if isAdmin();
    }

    match /office_settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /holidays/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /monthly_reports/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.employeeUid == request.auth.uid);
      allow write: if isAdmin();
    }

    match /notifications/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.recipientUid == request.auth.uid);
      allow write: if isAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
